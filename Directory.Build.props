<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RuleGateTargetFrameworks>net8.0;net9.0;net10.0</RuleGateTargetFrameworks>

    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <VersionPrefix>0.7.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>

    <Authors>Fotbiler</Authors>
    <Company>Fotbiler</Company>
    <Product>RuleGate</Product>
    <Copyright>Copyright © 2026 Fotbiler</Copyright>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fotbiler-lab/rulegate</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fotbiler-lab/rulegate</PackageProjectUrl>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageTags>authorization;rbac;policy;security;access-control;rulegate</PackageTags>
    <PackageReleaseNotes>Adds ordered ASP.NET Core subject, resource, and context attribute enrichment with explicit collision behavior, cancellation, fail-closed providers, and safe diagnostics across .NET 8, .NET 9, and .NET 10.</PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <EnablePackageValidation>true</EnablePackageValidation>

    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

    <ContinuousIntegrationBuild
      Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
