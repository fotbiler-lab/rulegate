<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>14.0</LangVersion>

    <RuleGateTargetFrameworks>net8.0;net9.0;net10.0</RuleGateTargetFrameworks>
    <RuleGateLibraryTargetFrameworks>netstandard2.0;$(RuleGateTargetFrameworks)</RuleGateLibraryTargetFrameworks>
    <RuleGateAspNetCoreTargetFrameworks>netcoreapp3.1;net5.0;net6.0;net7.0;$(RuleGateTargetFrameworks)</RuleGateAspNetCoreTargetFrameworks>

    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>

    <Authors>Fotbiler</Authors>
    <Company>Fotbiler</Company>
    <Product>RuleGate</Product>
    <Copyright>Copyright © 2026 Eren Gaygusuz</Copyright>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fotbiler-lab/rulegate</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fotbiler-lab/rulegate</PackageProjectUrl>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>rulegate-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageTags>authorization;rbac;policy;security;access-control;rulegate</PackageTags>
    <PackageReleaseNotes>Publishes the stable RuleGate 1.0 API and coordinated NuGet package family after release-candidate API freeze, security hardening, reproducibility, and package-only compatibility verification.</PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <EnablePackageValidation
      Condition="'$(MSBuildProjectName)' == 'Fotbiler.RuleGate.Abstractions' Or
                 '$(MSBuildProjectName)' == 'Fotbiler.RuleGate.Core' Or
                 '$(MSBuildProjectName)' == 'Fotbiler.RuleGate.Manifest' Or
                 '$(MSBuildProjectName)' == 'Fotbiler.RuleGate.AspNetCore' Or
                 '$(MSBuildProjectName)' == 'Fotbiler.RuleGate.Cli' Or
                 '$(MSBuildProjectName)' == 'Fotbiler.RuleGate.Keycloak'">true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0-rc.1</PackageValidationBaselineVersion>
    <ApiCompatPermitUnnecessarySuppressions>false</ApiCompatPermitUnnecessarySuppressions>
    <ApiCompatPreserveUnnecessarySuppressions>false</ApiCompatPreserveUnnecessarySuppressions>

    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

    <ContinuousIntegrationBuild
      Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <CheckEolTargetFramework
      Condition="'$(TargetFramework)' == 'netcoreapp3.1' Or
                 '$(TargetFramework)' == 'net5.0' Or
                 '$(TargetFramework)' == 'net6.0' Or
                 '$(TargetFramework)' == 'net7.0'">false</CheckEolTargetFramework>
    <MeziantouPolyfill_ExcludedPolyfills
      Condition="'$(TargetFramework)' == 'netcoreapp3.1' Or
                 '$(TargetFramework)' == 'net5.0' Or
                 '$(TargetFramework)' == 'net6.0' Or
                 '$(TargetFramework)' == 'net7.0'">M:System.Linq.Enumerable.AggregateBy|M:System.Linq.Enumerable.CountBy</MeziantouPolyfill_ExcludedPolyfills>
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)packaging/nuget/rulegate-icon.png"
      Pack="true"
      PackagePath="\"
      Link="rulegate-icon.png"
      Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or
                        '$(TargetFramework)' == 'netcoreapp3.1' Or
                        '$(TargetFramework)' == 'net5.0' Or
                        '$(TargetFramework)' == 'net6.0' Or
                        '$(TargetFramework)' == 'net7.0'">
    <PackageReference
      Include="Meziantou.Polyfill"
      Version="1.0.57"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference
      Include="System.Threading.Tasks.Extensions"
      Version="4.6.3" />
  </ItemGroup>
</Project>
