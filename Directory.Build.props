<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>

    <Authors>Fotbiler</Authors>
    <Company>Fotbiler</Company>
    <Product>Fotbiler RuleGate</Product>
    <Copyright>Copyright © 2026 Fotbiler</Copyright>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fotbiler-lab/rulegate</RepositoryUrl>
    <PackageProjectUrl>https://github.com/fotbiler-lab/rulegate</PackageProjectUrl>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageTags>authorization;rbac;policy;security;access-control;rulegate</PackageTags>
    <PackageReleaseNotes>Adds ASP.NET Core dependency injection, ClaimsPrincipal mapping, resource-based authorization handler integration, package-only consumer verification, and Trusted Publishing support.</PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <EnablePackageValidation>true</EnablePackageValidation>

    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>

    <ContinuousIntegrationBuild
      Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
