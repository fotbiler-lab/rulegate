  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "jsdom": "28.0.0",
    "ng-packagr": "22.0.2",
    "prettier": "3.8.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
