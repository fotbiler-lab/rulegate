{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@fotbiler/rulegate-angular": ["./src/Fotbiler.RuleGate.Angular/src/public-api.ts"],
      "@fotbiler/rulegate-angular/keycloak": [
        "./src/Fotbiler.RuleGate.Angular/keycloak/src/public-api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./src/Fotbiler.RuleGate.Angular/tsconfig.lib.json"
    },
    {
      "path": "./src/Fotbiler.RuleGate.Angular/tsconfig.spec.json"
    }
  ]
}
