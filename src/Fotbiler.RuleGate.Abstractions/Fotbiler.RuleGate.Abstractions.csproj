<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RuleGateTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Fotbiler.RuleGate.Abstractions</PackageId>
    <Title>Fotbiler RuleGate Abstractions</Title>
    <Description>Public authorization contracts, typed attribute values, policy definitions, requests, decisions, requirement evaluation abstractions, and diagnostics contracts for Fotbiler RuleGate.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)../../packaging/nuget/Fotbiler.RuleGate.Abstractions/README.md"
      Pack="true"
      PackagePath="\"
      Link="README.md"
      Visible="false" />
  </ItemGroup>

</Project>
