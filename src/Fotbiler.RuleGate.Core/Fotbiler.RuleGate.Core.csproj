<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fotbiler.RuleGate.Abstractions\Fotbiler.RuleGate.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference
      Include="System.Diagnostics.DiagnosticSource"
      Version="6.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>$(RuleGateLibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Fotbiler.RuleGate.Core</PackageId>
    <Title>RuleGate Core</Title>
    <Description>Fail-closed policy authorization engine with built-in evaluators, immutable atomic snapshots, last-valid reload behavior, safe diagnostics, and exporter-neutral OpenTelemetry signals for RuleGate.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Fotbiler.RuleGate.Core.Compatibility" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)../../packaging/nuget/Fotbiler.RuleGate.Core/README.md"
      Pack="true"
      PackagePath="\"
      Link="README.md"
      Visible="false" />
  </ItemGroup>

</Project>
