<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference
      Include="..\Fotbiler.RuleGate.Abstractions\Fotbiler.RuleGate.Abstractions.csproj" />
    <ProjectReference
      Include="..\Fotbiler.RuleGate.Core\Fotbiler.RuleGate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>$(RuleGateTargetFrameworks)</TargetFrameworks>

    <PackageId>Fotbiler.RuleGate.AspNetCore</PackageId>
    <Title>RuleGate ASP.NET Core</Title>
    <Description>ASP.NET Core dependency injection, ClaimsPrincipal mapping, dynamic policies, resource authorization, TimeProvider integration, and safe diagnostics for RuleGate.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)../../packaging/nuget/Fotbiler.RuleGate.AspNetCore/README.md"
      Pack="true"
      PackagePath="\"
      Link="README.md"
      Visible="false" />
  </ItemGroup>

</Project>
