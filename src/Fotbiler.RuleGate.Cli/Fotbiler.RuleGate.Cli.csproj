<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(RuleGateTargetFrameworks)</TargetFrameworks>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rulegate</ToolCommandName>
    <UseAppHost>false</UseAppHost>
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>

    <PackageId>Fotbiler.RuleGate.Cli</PackageId>
    <Title>RuleGate CLI</Title>
    <Description>Command-line manifest validation, deterministic C# constant generation, stale-output checks, diagnostics, and automation tooling for RuleGate.</Description>
    <PackageTags>$(PackageTags);cli;dotnet-tool;manifest;validation;code-generation;generator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="System.CommandLine"
      Version="2.0.10" />

    <ProjectReference
      Include="..\Fotbiler.RuleGate.Manifest\Fotbiler.RuleGate.Manifest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)../../packaging/nuget/Fotbiler.RuleGate.Cli/README.md"
      Pack="true"
      PackagePath="\"
      Link="README.md"
      Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute
      Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fotbiler.RuleGate.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
